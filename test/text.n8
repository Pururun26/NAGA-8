import naga

class App:
    def __init__(self):
        self.t = 0
        naga.run(self.update, self.draw)

    def update(self):
        self.t += 1

    def draw(self):
        naga.cls(1)                       # Navy фон
        naga.text("Hello, NAGA-8!", 4, 4, 7)      # белым
        naga.text("Score: %d" % self.t, 4, 12, 10) # жёлтым
        naga.text("line1\nline2\nline3", 4, 24, 11) # построчно, зелёным

App()