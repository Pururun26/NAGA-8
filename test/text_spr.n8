import naga

class App:
    def __init__(self):
        # Спрайт 1 (машинка 8x8)
        naga.sprdata(1, (
            "00000000",
            "01111000",
            "08888000",
            "18888100",
            "11111100",
            "08808800",
            "08008000",
            "00000000",
        ))

        naga.sprdata(3, (
            "02200220",
            "20022002",
            "20000002",
            "20000002",
            "02000020",
            "00200200",
            "00022000",
            "00000000"
        ))

        # Спрайт 2 (дерево 16x16)
        naga.sprdata(2, (
            "0000000330000000",
            "0000003333000000",
            "0000033113300000",
            "0000311111330000",
            "0003311111133000",
            "0003111111113000",
            "0031111111111300",
            "0311111111111130",
            "0311111111111130",
            "0003311111133000",
            "0000031111330000",
            "0000003113000000",
            "0000000330000000",
            "0000000330000000",
            "0000000330000000",
            "0000000330000000",
        ))
        
        self.x = 0
        self.dir = 1
        naga.run(self.update, self.draw)

    def update(self):
        self.x += self.dir
        if self.x > 110 or self.x < 0:
            self.dir *= -1

    def draw(self):
        naga.cls(6)  # Light Blue (небо)
        
        # Рисуем дерево на фоне
        naga.spr(3, 56, 20)
        
        # Рисуем машинку, которая ездит
        flip = 0 if self.dir > 0 else 1
        naga.spr(1, self.x, 100, flip, 0)

App()